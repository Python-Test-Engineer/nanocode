# OPENROUTER
OPENROUTER_API_KEY=sk-or-v1-
MODEL="deepseek-v4.1-flash-1017"
OPENROUTER_MODEL="deepseek-v4.1-flash-1017"
NANOCODE_BRAIN="openrouter"

# Sound hooks: media (WAV via PlaySound), 1 (beep tones), or unset to disable

NANOCODE_SOUND=media
# Sound files and mute are set in nanocode/sounds.json
# Optional: override the WAV for each hook (full paths; leave commented to use defaults)
# NANOCODE_SOUND_START=C:\Windows\Media\Windows Notify.wav
# NANOCODE_SOUND_LOOP=C:\Windows\Media\ding.wav
# NANOCODE_SOUND_DONE=C:\Windows\Media\tada.wav

# Nanocode: which brain to use by default (see llm.py BRAINS)

